<?xml version="1.0" encoding="UTF-8"?>
<!--
  承認依頼アドイン manifest
  ※ "YOUR_GITHUB_ID" を自分のGitHubユーザー名に「すべて置換」してから読み込んでください。
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>3a589eb8-12f2-470d-b228-5fcaf5149dd9</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Hayato Watanabe</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="承認依頼"/>
  <Description DefaultValue="返信・新規メールの先頭に承認／却下ボタンを差し込みます。"/>
  <IconUrl DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/"/>
  <AppDomains>
    <AppDomain>https://YOUR_GITHUB_ID.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/commands.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>

          <!-- メール作成画面（新規・返信・転送）のリボンにボタンを表示 -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="approvalGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="insertApprovalButton">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertApproval</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://YOUR_GITHUB_ID.github.io/outlook-approval-addin/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="承認"/>
        <bt:String id="ButtonLabel" DefaultValue="承認依頼"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTooltip" DefaultValue="Toの宛先を承認者として、本文の先頭に承認／却下ボタンを差し込みます。"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
